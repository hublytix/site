{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
          {
                  "source": "/:path*",
                  "has": [
                            {
                                        "type": "host",
                                        "value": "www.hublytix.ai"
                            }
                  ],
                  "destination": "https://hublytix.ai/:path*",
                  "permanent": true
          }
    ]
}
